# Firebase Web 設定（Console → 專案設定 → 您的應用程式）
# 這些值本來就會暴露在前端，請用 Firestore 規則保護資料
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 工會站點 ID（預設 omiyage）
VITE_GUILD_ID=omiyage

# LINE LIFF ID（選填；設定後用 LINE 顯示名稱，免手動暱稱）
# 到 https://developers.line.biz/ 建立 LIFF 應用取得
VITE_LIFF_ID=
